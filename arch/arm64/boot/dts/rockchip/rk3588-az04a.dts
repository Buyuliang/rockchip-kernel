	pca9555_j11: gpio@20 {
		compatible = "nxp,pca9555";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x20>;
	};
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m2_xfer>;
	status = "okay";

	//edp1_gt1x: gt1x@14 {
	//	compatible = "goodix,gt1x";
	//	reg = <0x14>;
	//	pinctrl-names = "default";
	//	pinctrl-0 = <&touch_edp_gpio>;
