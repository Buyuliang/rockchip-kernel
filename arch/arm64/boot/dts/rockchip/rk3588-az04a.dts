	pca9555_j30: gpio@20 {
		compatible = "nxp,pca9555";
		gpio-controller;
		#gpio-cells = <2>;
		reg = <0x20>;
	};
};


&pwm3 {
	pinctrl-names = "active";
	pinctrl-0 = <&pwm3m2_pins>;
	status = "okay";
};

&pwm1 {
	pinctrl-names = "active";
	pinctrl-0 = <&pwm1m1_pins>;
	status = "okay";
};

&pwm13 {
	pinctrl-names = "active";
	pinctrl-0 = <&pwm13m0_pins>;
	status = "okay";
};

&pwm12 {
	pinctrl-names = "active";
	pinctrl-0 = <&pwm12m0_pins>;
	status = "okay";
