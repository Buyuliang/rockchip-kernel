/* vp0 & vp1 splice for 8K output */
&vp0 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER0 | 1 << ROCKCHIP_VOP2_ESMART0)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART0>;
};

&vp1 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER1 | 1 << ROCKCHIP_VOP2_ESMART1)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART1>;
};

&vp2 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER2 | 1 << ROCKCHIP_VOP2_ESMART2)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART2>;
};

&vp3 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER3 | 1 << ROCKCHIP_VOP2_ESMART3)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART3>;
};

&combphy0_ps {
	status = "okay";
};

&combphy1_ps {
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m2_xfer>;

	vdd_cpu_big0_s0: vdd_cpu_big0_mem_s0: rk8602@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big0_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_s0: vdd_cpu_big1_mem_s0: rk8603@43 {
		compatible = "rockchip,rk8603";
		reg = <0x43>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big1_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m2_xfer>;

	vdd_npu_s0: vdd_npu_mem_s0: rk8602@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_npu_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c6 {
	status = "okay";
	pinctrl-0 = <&i2c6m4_xfer>;

	hym8563: hym8563@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "hym8563";
		pinctrl-names = "default";
		pinctrl-0 = <&hym8563_int>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};
};

&pcie2x1l0 { // combphy1, to AP6275P
	pinctrl-0 = <&pcie2x1l0_pins>;
	pinctrl-names = "default";
	reset-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&pcie2x1l1 {
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	status = "disabled";
};

&pcie30phy {
	rockchip,pcie30-phymode = <PHY_MODE_PCIE_AGGREGATION>; /* P1:PCIe3x2  +  P0:PCIe3x2 */
	status = "disabled";
};

&pcie3x4 {
	pinctrl-0 = <&pcie30x4m2_pins>;
	pinctrl-names = "default";
    reset-gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_pcie30>;
    status = "disabled";
};

&pinctrl {
	work {
		work_ctl: work-ctl {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdmmc {
		sd_s0_pwr: sd-s0-pwr {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		sdmmc_wp: sdmmc-wp {
			rockchip,pins = <3 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	usb {
		vcc5v0_host_en: vcc5v0-host-en {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pcie {
		pcie-pwren-h-1v8 {
			rockchip,pins = <0x01 0x14 0x00 0xff>;
		};

		pcie3x4_pins: pcie3x4-pins {
			rockchip,pins = <0x03 0x14 0x04 0xff 0x03 0x16 0x04 0xff 0x03 0x15 0x04 0xff>;
		};

		pcie2x1l0_pins: pcie2x1l0-pins {
			rockchip,pins = /* pcie30x1_0_clkreqn_m2 */
							<1 RK_PB5 4 &pcfg_pull_none>,
							/* pcie30x1_0_perstn_m2 */
							<1 RK_PB4 4 &pcfg_pull_none>,
							/* pcie30x1_0_waken_m2 */
							<1 RK_PB3 4 &pcfg_pull_none>;
		};
	};

	wireless-wlan {
		wifi_host_wake_irq: wifi-host-wake-irq {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_down>;
		};

		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	hym8563 {
		hym8563_int: hym8563-int {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wireless-bluetooth {
		uart6_gpios: uart6-gpios {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	fan {
		fan-tack-in {
			rockchip,pins = <0x03 RK_PB3 0x00 0x103>;
		};
	};

	gpio-keys {
		pwr_press_det: pwr-press-det {
			rockchip,pins = <0x00 RK_PB7 0x00 0xff>;
		};
	};

	edp {
		edp0_hpd: edp0-hpd {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		edp1_hpd: edp1-hpd {
			rockchip,pins = <3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
    };

	usb {

		usb20_host_pwren0_1v8: usb20-host-pwren0-1v8 {
			rockchip,pins = <0x01 RK_PB7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		usb20_host_pwren1_1v8: usb20-host-pwren1-1v8 {
			rockchip,pins = <0x01 RK_PD6 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		usb20_host_pwren2_1v8: usb20-host-pwren2-1v8 {
			rockchip,pins = <0x01 RK_PD7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		usb30_host_pwren0_1v8: usb30-host-pwren0-1v8 {
			rockchip,pins = <0x02 RK_PB4 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		usb30_host_pwren1_1v8: usb30-host-pwren1-1v8 {
			rockchip,pins = <0x02 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		usb30_host_pwren2_1v8: usb30-host-pwren2-1v8 {
			rockchip,pins = <0x01 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		usb30_host_pwren3_1v8: usb30-host-pwren3-1v8 {
			rockchip,pins = <0x01 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	mipi {
		mipi_pwren_1v8: mipi-pwren-1v8 {
			rockchip,pins = <0x04 0x16 0x00 0xff>;
		};

		mipi_pwren_3v3: mipi-pwren-3v3 {
			rockchip,pins = <0x02 0x14 0x00 0xff>;
		};
	};

	lcd {
		lcd0_rst_gpio: lcd0-rst-gpio {
			rockchip,pins = <1 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd1_rst_gpio: lcd1-rst-gpio {
			rockchip,pins = <1 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		//mipidcphy0_pwr: mipidcphy0-pwr {
		//	rockchip,pins =
		//		/* camera power en */
		//		<2 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		//};
	};

	touch0 {
		touch0_gpio: touch0-gpio {
			rockchip,pins =
				<3 RK_PC0 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	touch1 {
		touch1_gpio: touch1-gpio {
			rockchip,pins =
				<3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	touch_edp {
		touch_edp_gpio: touch-edp-gpio {
			rockchip,pins =
				<1 RK_PD1 RK_FUNC_GPIO &pcfg_pull_up>,
				<1 RK_PD0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	sata {
		sata_pwr: sata-pwr-en-h-1v8 {
			rockchip,pins = <1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&edp0 {
	pinctrl-names = "default";
    pinctrl-0 = <&edp0_hpd>;
	hpd-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
	#sound-dai-cells = <1>;
	status = "okay";
};

&edp0_in_vp0 {
	status = "okay";
};

&hdptxphy0 {
	status = "okay";
};

&route_edp0 {
	status = "okay";
	connect = <&vp0_out_edp0>;
};

&edp1 {
	force-hpd;
	status = "disabled";
	pinctrl-names = "default";
    pinctrl-0 = <&edp1_hpd>;
	hpd-gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;
	ports {
		port@1 {
			reg = <1>;

			edp1_out_panel: endpoint {
				remote-endpoint = <&panel_in_edp1>;
			};
		};
	};
};

&edp1_in_vp0 {
	status = "disabled";
};

&edp1_in_vp1 {
	status = "disabled";
};

&edp1_in_vp2 {
	status = "okay";
};

&hdptxphy1 {
	status = "okay";
};

&route_edp1 {
	status = "okay";
	connect = <&vp1_out_edp1>;
};

&sata0 {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m2_xfer>;
	status = "okay";
};

&uart6 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart6m1_xfer &uart6m1_ctsn>;
	status = "okay";
};

&dsi0 {
	status = "disabled";
	rockchip,lane-rate = <1000>;

};

&dsi1 {
	status = "disabled";
};

/*
 * mipi_dcphy0 needs to be enabled
 * when dsi0 is enabled
 */
&dsi0 {
	status = "disabled";
};

&dsi0_in_vp2 {
	status = "disabled";
};

&dsi0_in_vp3 {
	status = "disabled";
};

&mipi_dcphy0 {
	status = "disabled";
};

&mipi_dcphy1 {
	status = "disabled";
};

&backlight {
	pwms = <&pwm3 0 25000 0>;
	status = "disabled";
};

&backlight0 {
	pwms = <&pwm3 0 25000 0>;
	status = "disabled";
};

&backlight1 {
	pwms = <&pwm1 0 25000 0>;
	status = "disabled";
};

&pwm2 {
	status = "okay";
};

&route_dsi0 {
	status = "disabled";
	connect = <&vp3_out_dsi0>;
};

&route_dsi1 {
	status = "disabled";
	connect = <&vp3_out_dsi1>;
};

&i2c8 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8m4_xfer>;
	status = "okay";

	//mipi0_gt1x: gt1x@14 {
	//	compatible = "goodix,gt1x";
